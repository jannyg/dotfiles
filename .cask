# Install native apps

function installcask() {
	brew install --cask "${@}" 2> /dev/null
}

installcask iterm2
installcask virtualbox
installcask vagrant
#installcask vlc
#installcask spotify
installcask 1password
installcask rectangle-pro
installcask slack
installcask ngrok
installcask pycharm-ce
